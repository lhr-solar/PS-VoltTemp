	(text "The TX/RX lines are relative to MCU, \nso connect ESP_UART_RX to MCU's UART_RX\nand ESP_UART_TX to MCU's UART_TX"
		(exclude_from_sim no)
		(at 215.9 91.186 0)
		(effects
